; THE FORCING FUNCTION (#78): parse a signed webhook payload and return a
; validated event. This is the artifact the capability-vocabulary work exists to
; make possible, and every piece of it was added because this needed it — not
; because a framework would want it.
;
; It exercises the whole promise end to end: a proven artifact, built by
; `oath build`, wired to real effects exactly once at the boundary, serving real
; HTTP.
;
; What is PROVEN here is the handler's LOGIC — that an unsigned request is
; rejected, that a stale one is rejected, that nothing is emitted unless the
; signature verified. What is TRUSTED is exactly one thing: HMAC-SHA256 itself,
; which is outside the provable fragment on purpose (an axiomatization we
; invented would prove things about our axioms, not about the algorithm). That
; boundary is the honest shape of a verified system touching cryptography, and
; naming it precisely is worth more than pretending it is not there.
;
; Time is REQUEST DATA (`received-at`), not an ambient clock — supplied once at
; the boundary, so the handler stays deterministic and the generator quantifies
; over it for free. This does not settle the time/interleaving model (docs/
; effects.md stage 3) and does not claim to; it is enough to prove the
; integration story without pretending the research question is answered.

; Signatures arrive as HEX text (GitHub, Stripe and friends all do this), while
; the digest is 32 raw bytes. Comparing the header's codepoints against the digest
; can never match — it rejects everything, including valid requests, which is a
; failure mode that looks exactly like working security. Found by running real
; signed traffic against the built binary rather than by reading the code.
(defn hex-nibble [] [(c Int)] Int
  (if (and (<= 48 c) (<= c 57)) (- c 48)
      (if (and (<= 97 c) (<= c 102)) (- c 87)
          (if (and (<= 65 c) (<= c 70)) (- c 55) -1)))
  (prop digits [(c Int)] (if (and (<= 48 c) (<= c 57)) (== (hex-nibble c) (- c 48)) true))
  (prop rejects-non-hex [] (== (hex-nibble 122) -1)))

; Invalid hex decodes to the empty list, which cannot equal a 32-byte digest, so
; malformed input fails closed — for EVERY malformed string. That is a stronger
; claim than it looks, and it was FALSE until #121.
;
; The decoder cannot report failure in its own return type: `(List Int)` has one
; empty value, so `Nil` has to mean exactly one thing. Deciding validity FIRST is
; what makes it mean it. Left to itself the natural pair-by-pair recursion returns
; the prefix it managed to decode, so `<correct digest>zz` decoded to the correct
; digest and the handler below accepted a value this comment said it rejected.
;
; Validity is therefore a SEPARATE definition rather than a flag threaded through
; the decode, because it is what the property has to quantify over: the claim is
; about every invalid string, and there was no name for that set.
;
; It is also separate for a reason that has nothing to do with specification, and
; that the first attempt at this fix got wrong: the decoder must decide validity
; ONCE, not once per pair. Checking the remaining tail inside the recursion is
; quadratic, and a valid 1024-character digest then exhausted the evaluator's fuel
; where the old linear decoder handled 4096. The three-definition shape below is
; what makes the check linear — decide, then decode something already decided.
(defn hex-valid [] [(s Str)] Bool
  (match s
    ((SNil) true)
    ((SCons hi rest)
      (match rest
        ((SNil) false)
        ((SCons lo more)
          (if (or (< (hex-nibble hi) 0) (< (hex-nibble lo) 0))
              false
              (hex-valid more))))))
  (prop empty-is-valid [] (hex-valid (SNil)))
  (prop pair-is-valid [] (hex-valid "ff"))
  (prop odd-length-is-invalid [] (not (hex-valid "abc")))
  (prop trailing-junk-is-invalid [] (not (hex-valid "ffzz")))
  ; The three below exist because mutation scoring asked for them, and each names
  ; a boundary the others cannot reach. "00" is the only witness that distinguishes
  ; `< 0` from `<= 0` on the nibble sentinel — every other case here has a nonzero
  ; nibble. "zf" and "fz" are the only witnesses that reach a HALF-invalid pair,
  ; where one nibble decodes and the other does not; without them `or` reads the
  ; same as `and` and the -1 sentinel can move without any property noticing.
  (prop zero-pair-is-valid [] (hex-valid "00"))
  (prop a-bad-high-nibble-is-invalid [] (not (hex-valid "zf")))
  (prop a-bad-low-nibble-is-invalid [] (not (hex-valid "fz"))))

; The bytes of a string ALREADY KNOWN to be valid hex. The name carries its own
; precondition because nothing in the type does: on anything else it returns the
; prefix it could decode, which is exactly the behaviour #121 was filed about. It
; is safe here because `hex-decode` below is the only way in, and it decides.
;
; Note what is ABSENT: there is no nibble check. Re-testing what the caller has
; established would be the quadratic mistake in a cheaper disguise, and it would
; also leave mutants no property could kill — a mutated check on input the
; contract excludes changes nothing observable, so the score would have to be
; waived rather than earned.
(defn hex-decode-unchecked [] [(s Str)] (List Int)
  (match s
    ((SNil) (Nil [Int]))
    ((SCons hi rest)
      (match rest
        ((SNil) (Nil [Int]))
        ((SCons lo more)
          (Cons [Int] (+ (* 16 (hex-nibble hi)) (hex-nibble lo))
                (hex-decode-unchecked more))))))
  (prop empty-decodes-empty [] (== (hex-decode-unchecked (SNil)) (Nil [Int])))
  (prop decodes-ff [] (== (hex-decode-unchecked "ff") (Cons [Int] 255 (Nil [Int]))))
  (prop decodes-00 [] (== (hex-decode-unchecked "00") (Cons [Int] 0 (Nil [Int]))))
  (prop decodes-both-nibbles [] (== (hex-decode-unchecked "10") (Cons [Int] 16 (Nil [Int]))))
  (prop decodes-a-pair-of-pairs []
    (== (hex-decode-unchecked "0aff") (Cons [Int] 10 (Cons [Int] 255 (Nil [Int]))))))

(defn hex-decode [] [(s Str)] (List Int)
  (if (hex-valid s) (hex-decode-unchecked s) (Nil [Int]))
  (prop empty-decodes-empty [] (== (hex-decode (SNil)) (Nil [Int])))
  (prop decodes-ff [] (== (hex-decode "ff") (Cons [Int] 255 (Nil [Int]))))
  (prop decodes-00 [] (== (hex-decode "00") (Cons [Int] 0 (Nil [Int]))))
  ; This property used to read `(== (hex-decode "zz") (Nil [Int]))`. It was PROVEN,
  ; and it was true of a decoder that failed closed only when the FIRST pair was
  ; bad — its universe came from the implementation's easy case. This one comes
  ; from the claim.
  (prop invalid-fails-closed [(s Str)]
    (if (not (hex-valid s)) (== (hex-decode s) (Nil [Int])) true))
  ; The concrete witness that DISTINGUISHES this decoder from the old one, kept
  ; alongside the general property so the regression has a name: a correct digest
  ; followed by junk is not a correct digest.
  (prop trailing-junk-fails-closed [] (== (hex-decode "ffzz") (Nil [Int])))
  ; The general property above is PROVEN over every `Str`, and these two are still
  ; not redundant — proof and spec-strength read a property through different
  ; instruments. Mutation scoring EXECUTES a property on generated inputs, and the
  ; generator does not produce HALF-invalid pairs (one nibble decodes, the other
  ; does not), so a mutant that only misbehaves there survived a property that
  ; logically excludes it. A literal witness is what makes the score honest.
  (prop a-bad-high-nibble-fails-closed [] (== (hex-decode "zf") (Nil [Int])))
  (prop a-bad-low-nibble-fails-closed [] (== (hex-decode "fz") (Nil [Int]))))

(defn within-window [] [(now Int) (stamp Int) (window Int)] Bool
  (if (< now stamp)
      (<= (- stamp now) window)
      (<= (- now stamp) window))
  (prop same-instant-ok [(t Int) (w Int)]
    (if (<= 0 w) (within-window t t w) true))
  (prop symmetric [(a Int) (b Int) (w Int)]
    (== (within-window a b w) (within-window b a w)))
  (prop rejects-beyond [(now Int) (w Int)]
    (if (<= 0 w) (not (within-window now (+ now (+ w 1)) w)) true)))


; hex-encode exists so a PROPERTY can build a correctly-signed request. Without
; it nothing could reach the accept path: the generator cannot invent a valid
; signature, so every generated case took a rejection branch and mutation scoring
; recorded 3/176 — the artifact worked while its spec pinned almost nothing.
; That is precisely the "the proof conforms to a spec that may be incomplete"
; failure, caught by the instrument built for it.
(defn hex-digit [] [(n Int)] Int
  (if (< n 10) (+ 48 n) (+ 87 n))
  (prop zero-is-char-0 [] (== (hex-digit 0) 48))
  (prop ten-is-char-a [] (== (hex-digit 10) 97))
  (prop roundtrips [(n Int)]
    (if (and (<= 0 n) (<= n 15)) (== (hex-nibble (hex-digit n)) n) true)))

(defn hex-encode [] [(bs (List Int))] Str
  (match bs
    ((Nil) (SNil))
    ((Cons b rest)
      (SCons (hex-digit (/ b 16)) (SCons (hex-digit (% b 16)) (hex-encode rest)))))
  (prop empty-encodes-empty [] (== (hex-encode (Nil [Int])) (SNil)))
  (prop encodes-255 [] (== (hex-encode (Cons [Int] 255 (Nil [Int]))) "ff"))
  (prop roundtrips-through-decode [(bs (List Int))]
    (if (bytes-ok bs) (== (hex-decode (hex-encode bs)) bs) true)))

; The handler. Capabilities are `env` (the shared secret and the window) and
; `emit` (where a validated event goes). Both are ordinary (-> Str Str) — the
; existing shape — because that is all this artifact needs.
;
; Header names are LOWERCASE because SPEC §14.2 requires a backend to deliver
; them that way. This file invents its own wire format, so it could have spelled
; them however it liked — but an example that looked up `X-Signature` would be
; teaching a handler that authenticates nothing, since that name never arrives.
; #122 is where that stopped being hypothetical.
(defn webhook [] [(caps {emit (-> Str Str) env (-> Str Str)}) (r Request)] Response
  (match (header-first (req-headers r) "x-signature")
    ((None) (Resp 401 (Nil [(Pair Str Str)]) (Nil [Int])))
    ((Some given)
      (if (bytes-eq-ct (hex-decode given)
                       (hmac-sha256 (str-bytes ((. caps env) "WEBHOOK_SECRET")) (req-body r)))
          (match (header-first (req-headers r) "x-timestamp")
            ((None) (Resp 400 (Nil [(Pair Str Str)]) (Nil [Int])))
            ((Some ts)
              (if (within-window (req-received-at r) (parse-nat ts)
                                 (parse-nat ((. caps env) "WEBHOOK_WINDOW")))
                  (match ((. caps emit) (req-path r))
                    ((SNil) (Resp 500 (Nil [(Pair Str Str)]) (Nil [Int])))
                    ((SCons c rest) (Resp 202 (Nil [(Pair Str Str)]) (Nil [Int]))))
                  (Resp 400 (Nil [(Pair Str Str)]) (Nil [Int])))))
          (Resp 401 (Nil [(Pair Str Str)]) (Nil [Int])))))

  ; An unsigned request is rejected without consulting the secret, the clock, or
  ; the sink. Proven for ALL capability worlds the generator can build.
  (prop unsigned-is-401 [(caps {emit (-> Str Str) env (-> Str Str)}) (r Request)]
    (if (== (header-first (req-headers r) "x-signature") (None [Str]))
        (== (match (webhook caps r) ((Resp s h b) s)) 401)
        true))

  ; Only 202 ever means accepted. Every other path is a rejection, so a caller
  ; cannot mistake a 500 (sink failed) or a 400 (stale) for delivery.
  (prop accepts-only-with-202 [(caps {emit (-> Str Str) env (-> Str Str)}) (r Request)]
    (let (code Int (match (webhook caps r) ((Resp s h b) s)))
      (or (== code 202) (or (== code 401) (or (== code 400) (== code 500))))))

  ; THE ACCEPT PATH. Nothing generated can reach it — the generator cannot invent
  ; a valid signature — so the property CONSTRUCTS one: sign the body with
  ; whatever secret this capability world returns, stamp the timestamp at the
  ; instant of receipt, and assert the request is accepted. Without this the spec
  ; constrained only rejections and mutation scoring read 3/176: the artifact
  ; worked while its specification pinned almost nothing.
  ;
  ; The emit branch is guarded rather than assumed: a generated sink may fail,
  ; and a failed sink is honestly a 500, not an acceptance.
  ; The configured window must parse to a NON-NEGATIVE number. A generated `env`
  ; returns arbitrary text, and parse-nat of a non-digit yields a negative value
  ; — under which every request is stale. The handler failing closed there is
  ; correct behaviour, so this is a precondition of the accept path, not a bug.
  ; `now` must be a NATURAL: the timestamp crosses the wire through show-nat and
  ; comes back through parse-nat, and that round-trip only holds for naturals —
  ; a real received-at is an epoch second and never negative.
  ; The secret needs the same guard as the body: a generated `env` returns a Str
  ; whose codepoints may be negative, and signing those is a range error. Third
  ; place in this artifact where {b: Int | 0 <= b <= 255} would have said it in
  ; the type — #69's motivation, arriving from use rather than from theory.
  (prop accepts-correctly-signed [(caps {emit (-> Str Str) env (-> Str Str)}) (body (List Int)) (now Int)]
    (if (and (<= 0 (parse-nat ((. caps env) "WEBHOOK_WINDOW")))
             (and (<= 0 now) (and (bytes-ok body) (bytes-ok (str-bytes ((. caps env) "WEBHOOK_SECRET"))))))
        (let (sig Str (hex-encode (hmac-sha256 (str-bytes ((. caps env) "WEBHOOK_SECRET")) body)))
          (let (r Request (Req "POST" "/hook"
                               (Cons [(Pair Str Str)] (Pair [Str Str] "x-signature" sig)
                                 (Cons [(Pair Str Str)] (Pair [Str Str] "x-timestamp" (show-nat now))
                                   (Nil [(Pair Str Str)])))
                               body now))
            (match ((. caps emit) "/hook")
              ((SNil) (== (match (webhook caps r) ((Resp s h b) s)) 500))
              ((SCons c rest) (== (match (webhook caps r) ((Resp s h b) s)) 202)))))
        true))

  ; A tampered body must NOT be accepted under a signature computed for the
  ; original — the property that actually makes this a security artifact.
  (prop tampering-is-rejected [(caps {emit (-> Str Str) env (-> Str Str)}) (body (List Int)) (now Int)]
    (if (and (bytes-ok body) (bytes-ok (str-bytes ((. caps env) "WEBHOOK_SECRET"))))
        (let (sig Str (hex-encode (hmac-sha256 (str-bytes ((. caps env) "WEBHOOK_SECRET")) body)))
          (let (tampered (List Int) (Cons [Int] 88 body))
            (let (r Request (Req "POST" "/hook"
                                 (Cons [(Pair Str Str)] (Pair [Str Str] "x-signature" sig)
                                   (Cons [(Pair Str Str)] (Pair [Str Str] "x-timestamp" (show-nat now))
                                     (Nil [(Pair Str Str)])))
                                 tampered now))
              (== (match (webhook caps r) ((Resp s h b) s)) 401))))
        true))

  ; A response never carries a body or headers: this endpoint answers with a
  ; status and nothing else, so a signature failure cannot leak detail.
  (prop never-leaks-a-body [(caps {emit (-> Str Str) env (-> Str Str)}) (r Request)]
    (== (match (webhook caps r) ((Resp s h b) b)) (Nil [Int]))))

; KNOWN-ANSWER TEST — the conformance pin for the crypto primitives.
;
; Without this, NOTHING in the corpus observes a digest: webhook's generated
; cases all take the 401 path (the generator never invents the literal header
; "x-signature"), so byte order, argument order, and even the construction were
; unpinned. A kernel computing sha256(key ++ msg), or returning the digest
; reversed, or swapping key and msg, passed conformance. The blind Rust kernel
; found this while implementing from the spec — the spec fixed the DESIGN
; questions and the corpus could not fix the INTERFACE ones.
;
; RFC 4231 test case 2. This is `tested`, not `proven` — the crypto is outside
; the provable fragment on purpose — but it lands in the verify transcript, which
; IS byte-compared across kernels, so a kernel that computes a different digest
; now fails conformance instead of passing it.
(defn hmac-kat-rfc4231-2 [] [] Bool
  (bytes-eq-ct
    (hmac-sha256 (str-bytes "Jefe") (str-bytes "what do ya want for nothing?"))
    (hex-decode "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"))
  (prop matches-published-vector [] (hmac-kat-rfc4231-2))
  ; Argument order is observable: swapping key and message must NOT match.
  (prop arguments-are-not-symmetric []
    (not (bytes-eq-ct
           (hmac-sha256 (str-bytes "what do ya want for nothing?") (str-bytes "Jefe"))
           (hex-decode "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"))))
  ; Digests are 32 bytes, and a shorter operand must not compare equal — the
  ; fail-closed story depends on it, since hex-decode returns Nil on bad input.
  (prop length-mismatch-is-not-equal []
    (not (bytes-eq-ct
           (hmac-sha256 (str-bytes "Jefe") (str-bytes "what do ya want for nothing?"))
           (Nil [Int])))))
