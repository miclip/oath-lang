; The HTTP handler protocol (#78). These types are the BOUNDARY: `oath build`
; owns the irreversible translation between a network connection and a Request
; value, and everything above that line is an ordinary pure function verified
; against every request the generator can produce.
;
; The governing rule for the host adapter is SPEC §14.1: PRESERVE every
; semantically meaningful distinction the transport supplies, and CANONICALIZE
; distinctions the transport does not define or declares insignificant. Both
; halves are obligations.
;
; The earlier rule here was "normalize as little as possible", and it is
; withdrawn because it produced a real defect (#122). It read as a prohibition
; on all transformation, so when Go's net/http canonicalized header-name case
; the adapter recorded that as an unavoidable wart rather than making a decision
; — and an application ended up writing one backend's spelling, `X-Github-Event`,
; into its Oath source. The old rule also demanded something no adapter can
; supply: HTTP/2 mandates lowercase field names on the wire, so the sender's
; casing does not survive the transport and cannot be preserved.
;
; So: header names arrive LOWERCASE, entries are ordered lexicographically by
; name, and the authority appears as `host` whatever the HTTP version called it.
; Repeats under one name keep their arrival order and are never comma-joined,
; values cross unchanged, and method, raw path (with query) and body bytes are
; verbatim. Signature verification is precisely where an innocent host-side
; rewrite — collapsing a repeat, re-encoding a body — becomes a correctness bug
; that no test in the artifact can catch, because the artifact never sees the
; original; §14 exists so that what the artifact sees is the same on every
; conformant backend instead of merely close.
;
; Body is `(List Int)`, one Int per BYTE, deliberately not `Str`. Str is
; `SCons Int Str` over CODEPOINTS and compiles to a native Go string; a payload
; is bytes, may not be valid UTF-8, and is signed as bytes. Routing it through a
; codepoint type would put the corruption in the TYPE rather than in the adapter,
; where no amount of care downstream could recover it.
;
; received-at is a FIELD, not an ambient clock: time enters as data supplied once
; at the boundary, so a handler stays deterministic and the generator quantifies
; over it for free. This is the same resolution stateful worlds got (state is
; data, transitions are code). It does NOT settle the time/interleaving model.

(data Request []
  (Req Str Str (List (Pair Str Str)) (List Int) Int))

(data Response []
  (Resp Int (List (Pair Str Str)) (List Int)))

; Field accessors. Positional matching is unreadable at five fields, and these
; give properties something to talk about.
(defn req-method [] [(r Request)] Str
  (match r ((Req m p h b t) m))
  (prop reads-method [(m Str) (p Str) (h (List (Pair Str Str))) (b (List Int)) (t Int)]
    (== (req-method (Req m p h b t)) m)))

(defn req-path [] [(r Request)] Str
  (match r ((Req m p h b t) p))
  (prop reads-path [(m Str) (p Str) (h (List (Pair Str Str))) (b (List Int)) (t Int)]
    (== (req-path (Req m p h b t)) p)))

(defn req-headers [] [(r Request)] (List (Pair Str Str))
  (match r ((Req m p h b t) h))
  (prop reads-headers [(m Str) (p Str) (h (List (Pair Str Str))) (b (List Int)) (t Int)]
    (== (req-headers (Req m p h b t)) h)))

(defn req-body [] [(r Request)] (List Int)
  (match r ((Req m p h b t) b))
  (prop reads-body [(m Str) (p Str) (h (List (Pair Str Str))) (b (List Int)) (t Int)]
    (== (req-body (Req m p h b t)) b)))

(defn req-received-at [] [(r Request)] Int
  (match r ((Req m p h b t) t))
  (prop reads-received-at [(m Str) (p Str) (h (List (Pair Str Str))) (b (List Int)) (t Int)]
    (== (req-received-at (Req m p h b t)) t)))

; Header lookup returns the FIRST match and is case-SENSITIVE. Under SPEC §14
; that is correct BY CONSTRUCTION rather than a hazard the author must remember:
; a Request carries exactly one spelling of a name, so a case-insensitive lookup
; would have nothing extra to find. Look names up in lowercase — `x-github-event`,
; not `X-GitHub-Event`, whatever the sender wrote or the vendor documents.
;
; Returning the FIRST match is the separate, still-deliberate half: repeats are
; preserved as distinct entries (§14.2 REQ-HEADER-VALUES-NOT-JOINED), so a
; handler verifying a signature can see that a name arrived twice rather than
; have one of them silently chosen for it.
(defn header-first [] [(hs (List (Pair Str Str))) (name Str)] (Option Str)
  (match hs
    ((Nil) (None [Str]))
    ((Cons h rest)
      (match h
        ((Pair k v) (if (== k name) (Some [Str] v) (header-first rest name))))))
  (prop empty-has-none [(name Str)]
    (== (header-first (Nil [(Pair Str Str)]) name) (None [Str])))
  (prop finds-head [(v Str) (rest (List (Pair Str Str))) (name Str)]
    (== (header-first (Cons [(Pair Str Str)] (Pair [Str Str] name v) rest) name)
        (Some [Str] v)))
  (prop skips-mismatch [(k Str) (v Str) (rest (List (Pair Str Str))) (name Str)]
    (if (== k name) true
        (== (header-first (Cons [(Pair Str Str)] (Pair [Str Str] k v) rest) name)
            (header-first rest name)))))

; The protocol witness, deliberately boring: echo the body and report the method
; in a header. It isolates the protocol machinery — Request in, Response out,
; nothing to do with crypto, storage or time — so a failure here is unambiguously
; the boundary rather than the artifact. `main-fetch` plays the same role for the
; CLI protocol. Verified against every request the generator produces, then built
; and run against a real HTTP client: a 4-byte binary body (00 01 FE FF) crosses
; intact in both directions, which is the property that matters and the one a
; codepoint-typed body would have destroyed.
;
; `X-Oath-Method` is spelled in mixed case ON PURPOSE, and it is not an exception
; to §14: that section binds the REQUEST a backend constructs, not the response a
; handler emits. Outbound header names are the handler's own choice, HTTP treats
; them case-insensitively, and a host is free to transmit them in whatever case
; its library prefers. The asymmetry is real — inbound has one canonical form
; because agreement between backends depends on it; outbound does not.
(defn echo-handler [] [(r Request)] Response
  (Resp 200
        (Cons [(Pair Str Str)] (Pair [Str Str] "X-Oath-Method" (req-method r)) (Nil [(Pair Str Str)]))
        (req-body r))
  (prop echoes-body-exactly [(r Request)]
    (== (match (echo-handler r) ((Resp s h b) b)) (req-body r)))
  (prop always-200 [(r Request)]
    (== (match (echo-handler r) ((Resp s h b) s)) 200))
  (prop reports-method [(r Request)]
    (== (match (echo-handler r) ((Resp s h b) (header-first h "X-Oath-Method")))
        (Some [Str] (req-method r)))))

; --- byte helpers, needed because (List Int) does not constrain elements ---
; This is exactly the case refinement types (#69) exist for: {b: Int | 0 <= b <=
; 255} would say it in the type. Until then it is an explicit predicate, and
; every property that reaches the crypto must guard on it — the generator
; otherwise produces negative "bytes" and falsifies by construction.
(defn bytes-ok [] [(bs (List Int))] Bool
  (match bs
    ((Nil) true)
    ((Cons b rest) (and (and (<= 0 b) (<= b 255)) (bytes-ok rest))))
  (prop empty-is-ok [] (bytes-ok (Nil [Int])))
  (prop rejects-negative [(rest (List Int))] (not (bytes-ok (Cons [Int] -1 rest))))
  (prop rejects-oversized [(rest (List Int))] (not (bytes-ok (Cons [Int] 256 rest)))))

; Str is a list of CODEPOINTS; bytes are what get signed. For ASCII the two
; coincide, which is why the guard is a property rather than a comment: a
; non-ASCII secret would silently sign different bytes than intended.
(defn str-bytes [] [(s Str)] (List Int)
  (match s
    ((SNil) (Nil [Int]))
    ((SCons c rest) (Cons [Int] c (str-bytes rest))))
  (prop empty-maps-to-empty [] (== (str-bytes (SNil)) (Nil [Int])))
  (prop preserves-length [(s Str)] (== (length [Int] (str-bytes s)) (str-len s))))
