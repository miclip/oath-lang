(defn wanted [] [(caps {emit (-> Str Str) secret Str}) (r Request)] Response
  (Resp 500 (Nil [(Pair Str Str)]) (Nil [Int]))
  (prop accepts-with-any-usable-secret [(sink (-> Str Str)) (body (List Int)) (sec Str)]
    (if (and (bytes-ok body) (secret-is-usable sec))
      (let (rq Request (gh-request (gh-sign sec body) "push" "/hook" "application/json" body))
        (match (sink (gh-record rq))
          ((SNil)       (== (match (wanted (caps-with sink sec) rq) ((Resp s h b) s)) 500))
          ((SCons c cs) (== (match (wanted (caps-with sink sec) rq) ((Resp s h b) s)) 202))))
      true)))
