(defn wanted [] [(caps {emit (-> Str Str) secret Str}) (r Request)] Response
  (Resp 500 (Nil [(Pair Str Str)]) (Nil [Int]))
  (prop a-correctly-signed-push-is-accepted [(sink (-> Str Str)) (body (List Int))]
    (if (bytes-ok body)
      (let (rq Request (gh-request (gh-sign gh-spec-secret body)
                                   "push" "/hook" "application/json" body))
        (match (sink (gh-record rq))
          ((SNil)       (== (match (wanted (caps-with sink gh-spec-secret) rq) ((Resp s h b) s)) 500))
          ((SCons c cs) (== (match (wanted (caps-with sink gh-spec-secret) rq) ((Resp s h b) s)) 202))))
      true)))
