; A stats consumer built ON Oath: the arithmetic mean of a list of integers as an
; EXACT rational (ℚ), reusing the corpus's proven `sum` and `length`. The point of
; the exercise is not the mean — it is what a consumer wanting "mean is between the
; min and the max" runs into when it composes an Int fold with a ℚ result.
;
; Empty list: length 0, so the division would be by zero. Rat `/` by zero is
; normalized here to 0/1, exactly as rat-recover normalizes its divisor, so `mean`
; is total.

(defn mean [] [(xs (List Int))] Rat
  (if (== (length [Int] xs) 0)
      0/1
      (/ (to-rat (sum xs)) (to-rat (length [Int] xs))))

  (prop empty-is-zero []
    (== (mean (Nil [Int])) 0/1))

  ; The recovery law: mean times the count is the sum. Holds for the empty list too
  ; (0 * 0 = 0 = sum Nil), so no non-empty guard is needed. This is the rat-recover
  ; pattern and should land in Z3's complete real fragment.
  (prop times-count-is-sum [(xs (List Int))]
    (== (* (mean xs) (to-rat (length [Int] xs)))
        (to-rat (sum xs))))

  ; The bounds a consumer actually wants: for a non-empty list, the mean is between
  ; the minimum and the maximum. Stated with the seed = the head element, because
  ; the corpus min/max are SEEDED folds. This obligation is nonlinear — it unfolds to
  ; (minimum h t) * length <= sum <= (maximum h t) * length — so it is the honest
  ; test of whether Z3 discharges it or it stays `tested`.
  (prop within-bounds [(h Int) (t (List Int))]
    (and (<= (to-rat (minimum h t))
             (mean (Cons [Int] h t)))
         (<= (mean (Cons [Int] h t))
             (to-rat (maximum h t))))))
