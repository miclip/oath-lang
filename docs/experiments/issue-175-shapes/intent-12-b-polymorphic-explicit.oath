; Intent 12, SHAPE B — the POLYMORPHISM axis: [a] on the query definition, with
; the type application written out in the law.
(defn wanted [a] [(p (-> a Bool)) (xs (List a))] (List a) (Nil [a])
  (prop every-kept-element-passes [(p (-> Int Bool)) (xs (List Int))]
    (all [Int] p (wanted [Int] p xs))))
