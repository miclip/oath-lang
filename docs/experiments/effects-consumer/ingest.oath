; A MULTI-capability CLI, and the demands composing capabilities surfaces. It reads a
; config path from the ENVIRONMENT (process_env), reads that FILE (file_read), and
; EMITS a record derived from it (record_sink) — three authorities threaded through one
; verified entry point, sequenced (env feeds readfile), with the empty-string
; CALL-failure protocol branched on after each READ (the terminal emit is returned
; directly; record_sink separates its channel via OATH_EMIT_PATH — see the friction doc).
;
; The corpus witness main-fetch exercised ONE capability (http_request). This composes
; three, which is where the effects model's ergonomics — and its runtime channel model —
; get tested. The properties PROVE over ALL simulated worlds (every env/readfile/emit
; table at once); the frictions are recorded in effects-consumer-friction.md.
;
; Note the repetition: the capability record type is spelled out in the signature AND in
; every property binder because Oath has no named/aliased types. That is demand 2.

(defn ingest []
  [(cap {emit (-> Str Str) env (-> Str Str) readfile (-> Str Str)}) (args (List Str))]
  Str
  (match args
    ((Nil) "usage: ingest <config-var>")
    ((Cons var rest)
     (let (path Str ((. cap env) var))
       (if (== path "")
           "no config path in environment"
           (let (body Str ((. cap readfile) path))
             (if (== body "")
                 "config file empty or missing"
                 ((. cap emit) body)))))))

  (prop no-args-usage [(cap {emit (-> Str Str) env (-> Str Str) readfile (-> Str Str)})]
    (== (ingest cap (Nil [Str])) "usage: ingest <config-var>"))

  (prop missing-env-reported [(cap {emit (-> Str Str) env (-> Str Str) readfile (-> Str Str)}) (v Str) (rest (List Str))]
    (if (== ((. cap env) v) "")
        (== (ingest cap (Cons [Str] v rest)) "no config path in environment")
        true))

  ; The end-to-end contract over every world: when both reads succeed, the program's
  ; result is exactly what it handed the sink. `emit`'s own return is threaded through.
  (prop emits-file-body [(cap {emit (-> Str Str) env (-> Str Str) readfile (-> Str Str)}) (v Str) (rest (List Str))]
    (let (p Str ((. cap env) v))
      (if (== p "")
          true
          (let (b Str ((. cap readfile) p))
            (if (== b "")
                true
                (== (ingest cap (Cons [Str] v rest)) ((. cap emit) b))))))))
