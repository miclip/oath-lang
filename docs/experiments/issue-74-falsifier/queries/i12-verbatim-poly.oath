(defn wanted [a] [(p (-> a Bool)) (xs (List a))] (List a) (Nil [a])
  (prop empty-is-empty [(p (-> Int Bool))]
    (== (wanted [Int] p (Nil [Int])) (Nil [Int])))
  (prop cons-step [(p (-> Int Bool)) (x Int) (xs (List Int))]
    (== (wanted [Int] p (Cons [Int] x xs))
        (if (p x) (Cons [Int] x (wanted [Int] p xs)) (Nil [Int])))))
